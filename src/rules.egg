; Historical egglog specification retained for comparison. The runtime uses rules.rs.
; The ECMAScript meaning of the dumper's syntax, as egglog rules over one sort T. JS values are
; dynamically typed (if, maybe, let and app return whatever their branches do), so T is every
; value; the Clash relation catches a merge of two distinct constructors after the fact.
;
; The driver prepends the sorts, constructors and analysis functions, and the generated rules
; (free variables and let-pushing for every constructor), before this file.

; --- syntax forms to their meaning, one form per rule ---
(rewrite (Prop xs "length") (Len xs))
(rewrite (Elem xs k) (IndexQ xs k))
(rewrite (ArrCons h t) (Cons h t))
(rewrite (ArrSpread xs t) (Append xs t))
(rewrite (Coalesce a b) (Maybe b a))
(rewrite (Default m d) (Maybe d m))
(rewrite (MCall2 "slice" xs a b) (Sublist xs (Rel a (Len xs)) (Rel b (Len xs))))
(rewrite (MCall1 "slice" xs a) (Sublist xs (Rel a (Len xs)) (Len xs)))
(rewrite (MCall0 "slice" xs) xs)
(rewrite (Rel k n) (If (Lt k (Num 0)) (Max (Add n k) (Num 0)) (Min k n)))
(rewrite (MCall1 "at" xs k) (IndexQ xs (If (Lt k (Num 0)) (Add (Len xs) k) k)))
(rewrite (MCall2 "reduce" xs f z) (Foldl f z xs))
(rewrite (MCall1 "reduce" xs f) (If (Lt (Num 0) (Len xs)) (Foldl f (At xs (Num 0)) (Sublist xs (Num 1) (Len xs))) (Throw)))
(rewrite (MCall1 "map" xs f) (Map f xs))
; filter calls back with (element, index); Filteri carries the index.
(rewrite (MCall1 "filter" xs f) (Filteri f (Num 0) xs))
; find (ECMA-262 23.1.3.9) calls back with (element, index) and returns the first match, or
; undefined: the first element of the filtered list.
(rewrite (MCall1 "find" xs f) (IndexQ (Filteri f (Num 0) xs) (Num 0)))
(rewrite (MCall1 "concat" xs ys) (Append xs ys))
(rewrite (MCall0 "toReversed" xs) (Reverse xs))
(rewrite (Truthy (Len xs)) (Lt (Num 0) (Len xs)))
(rewrite (Truthy (Lt a b)) (Lt a b))
(rewrite (Truthy (Le a b)) (Le a b))
(rewrite (Truthy (EqI a b)) (EqI a b))
(rewrite (Truthy (StrictEq a b)) (StrictEq a b))
(rewrite (Truthy (Not a)) (Not a))
(rewrite (Truthy (And a b)) (And a b))
(rewrite (Truthy (Or a b)) (Or a b))
(rewrite (Truthy (B b)) (B b))

; --- binding (the let-pushing rules for every other constructor are generated) ---
(rewrite (App (Lam v body) e) (Let v e body))
(rule ((= x (Let v e body)) (= fb (free body)) (set-not-contains fb v)) ((union x body)) :name "let-unused")
(rewrite (Let v e (Var v)) e)
(rule ((= x (Let v e (Var w))) (!= v w)) ((union x (Var w))) :name "let-var-other")
(rewrite (Let v e (Lam v b)) (Lam v b))
(rule ((= x (Let v e (Lam w b))) (!= v w) (= fe (free e)) (set-not-contains fe w))
      ((union x (Lam w (Let v e b)))) :name "let-lam")
; A lambda that would capture a free variable of e is renamed first.
(rule ((= x (Let v e (Lam w b))) (!= v w) (= fe (free e)) (set-contains fe w))
      ((let fresh (+ w "'")) (union x (Lam fresh (Let v e (Let w (Var fresh) b))))) :name "let-lam-rename")
(rule ((= x (Let v e (Let v e2 b2)))) ((union x (Let v (Let v e e2) b2))) :name "let-let-same")
(rule ((= x (Let v e (Let w e2 b2))) (!= v w) (= fe (free e)) (set-not-contains fe w))
      ((union x (Let w (Let v e e2) (Let v e b2)))) :name "let-let")

; --- integer arithmetic: one affine normal form per class ---
; A form is a multiset of atoms, constants counted as copies of (Num 1) or (Num -1). linr(x, r) is
; x's form at rank r and linrank(x) its highest rank: a node's form is built from its children's
; highest-rank forms at one rank above them, and cancelling a +a/-a pair raises the rank again, so
; the highest-rank form of a class is its fully expanded, cancelled one. Lin(form) is the canonical
; e-node: two classes with the same form build the same Lin, and hash-consing merges them. There
; is no comm/assoc rewriting anywhere. A child counts as an atom unless it is strictly shallower
; than its parent, which bounds the ranks on classes defined through each other.
(rule ((= x (Add a b))) ((set (linr a 0) (multiset-of a)) (set (linrank a) 0) (set (linr b 0) (multiset-of b)) (set (linrank b) 0)) :name "lin-atoms-add")
(rule ((= x (Sub a b))) ((set (linr a 0) (multiset-of a)) (set (linrank a) 0) (set (linr b 0) (multiset-of b)) (set (linrank b) 0)) :name "lin-atoms-sub")
(rule ((= x (Neg a))) ((set (linr a 0) (multiset-of a)) (set (linrank a) 0)) :name "lin-atoms-neg")
(rule ((= x (Num k)) (> k 0)) ((set (linr x 1) (multiset-single (Num 1) k)) (set (linrank x) 1)) :name "lin-num-pos")
(rule ((= x (Num k)) (< k 0)) ((set (linr x 1) (multiset-single (Num -1) (- 0 k))) (set (linrank x) 1)) :name "lin-num-neg")
(rule ((= x (Num 0))) ((set (linr x 1) (multiset-remove (multiset-of (Num 1)) (Num 1))) (set (linrank x) 1)) :name "lin-num-zero")
; A node's form uses its children's only when they are strictly shallower than its class. The test
; is made in each rule against depth's current (min-merged) value, never stored: a stored "a is
; shallower than x" goes stale when x later merges with a shallower class, and then x's form is
; rebuilt from a child whose form is built from x, its rank climbing for ever.
(rule ((= x (Add a b)) (= dx (depth x)) (= da (depth a)) (< da dx) (= db (depth b)) (< db dx)
       (= ra (linrank a)) (= la (linr a ra)) (= rb (linrank b)) (= lb (linr b rb)))
      ((set (linr x (+ 1 (max ra rb))) (multiset-sum la lb)) (set (linrank x) (+ 1 (max ra rb)))) :name "lin-add")
(rule ((= x (Sub a b)) (= dx (depth x)) (= da (depth a)) (< da dx) (= db (depth b)) (< db dx)
       (= ra (linrank a)) (= la (linr a ra)) (= rb (linrank b)) (= lb (linr b rb)))
      ((set (linr x (+ 1 (max ra rb))) (multiset-sum la (unstable-multiset-map (unstable-fn "Neg") lb))) (set (linrank x) (+ 1 (max ra rb)))) :name "lin-sub")
(rule ((= x (Neg a)) (= dx (depth x)) (= da (depth a)) (< da dx) (= ra (linrank a)) (= la (linr a ra)))
      ((set (linr x (+ 1 ra)) (unstable-multiset-map (unstable-fn "Neg") la)) (set (linrank x) (+ 1 ra))) :name "lin-neg")
(rule ((= r (linrank x)) (= l (linr x r)) (= n (Neg a)) (= l1 (multiset-remove l n)) (= l2 (multiset-remove l1 a)))
      ((set (linr x (+ r 1)) l2) (set (linrank x) (+ r 1))) :name "lin-cancel")
; x = x + rest says the rest is zero.
(rule ((= r (linrank x)) (= l (linr x r)) (= rest (multiset-remove l x))) ((union (Lin rest) (Num 0))) :name "lin-self")
(rule ((= r (linrank x)) (= l (linr x r))) ((union x (Lin l)) (IsInt x)) :name "lin-node")
(rewrite (Neg (Num c)) (Num (- 0 c)))
(rewrite (Neg (Neg a)) a)
(rewrite (Mul (Num a) (Num b)) (Num (* a b)))
(rewrite (Mul a b) (Mul b a))
(rewrite (Mul (Num 0) a) (Num 0))
(rule ((= x (Num k))) ((IsInt x)) :name "int-num")
(rule ((= x (Len xs))) ((IsInt x)) :name "int-len")

; --- intervals: lo and hi merge by max and min; a closed interval is a constant ---
(rule ((= x (Num k))) ((set (lo x) k) (set (hi x) k)) :name "iv-num")
(rule ((= x (Len xs))) ((set (lo x) 0)) :name "iv-len")
; A Lin's interval: the atoms' bounds folded over the form. The map silently drops an element
; whose bound is undefined, so the lengths must agree (or "i < 0" gets decided false for an
; unbounded i); the fold's initial value only comes back for an empty form, which is 0.
(rule ((= x (Lin l)) (= ls (unstable-multiset-map (unstable-fn "lo") l)) (= (multiset-length ls) (multiset-length l)))
      ((set (lo x) (unstable-multiset-reduce (unstable-fn "+") 0 ls))) :name "iv-lin-lo" :naive)
(rule ((= x (Lin l)) (= hs (unstable-multiset-map (unstable-fn "hi") l)) (= (multiset-length hs) (multiset-length l)))
      ((set (hi x) (unstable-multiset-reduce (unstable-fn "+") 0 hs))) :name "iv-lin-hi" :naive)
(rule ((= x (Add a b)) (= la (lo a)) (= lb (lo b))) ((set (lo x) (+ la lb))) :name "iv-add-lo")
(rule ((= x (Add a b)) (= ha (hi a)) (= hb (hi b))) ((set (hi x) (+ ha hb))) :name "iv-add-hi")
(rule ((= x (Neg a)) (= ha (hi a))) ((set (lo x) (- 0 ha))) :name "iv-neg-lo")
(rule ((= x (Neg a)) (= la (lo a))) ((set (hi x) (- 0 la))) :name "iv-neg-hi")
(rule ((= x (Min a b)) (= la (lo a)) (= lb (lo b))) ((set (lo x) (min la lb))) :name "iv-min-lo")
(rule ((= x (Min a b)) (= ha (hi a))) ((set (hi x) ha)) :name "iv-min-hi1")
(rule ((= x (Min a b)) (= hb (hi b))) ((set (hi x) hb)) :name "iv-min-hi2")
(rule ((= x (Max a b)) (= la (lo a))) ((set (lo x) la)) :name "iv-max-lo1")
(rule ((= x (Max a b)) (= lb (lo b))) ((set (lo x) lb)) :name "iv-max-lo2")
(rule ((= x (Max a b)) (= ha (hi a)) (= hb (hi b))) ((set (hi x) (max ha hb))) :name "iv-max-hi")
(rule ((= x (If c a b)) (= la (lo a)) (= lb (lo b))) ((set (lo x) (min la lb))) :name "iv-if-lo")
(rule ((= x (If c a b)) (= ha (hi a)) (= hb (hi b))) ((set (hi x) (max ha hb))) :name "iv-if-hi")
(rule ((= x (Rel k n))) ((set (lo x) 0)) :name "iv-rel-lo")
(rule ((= x (Rel k n)) (= hn (hi n))) ((set (hi x) hn)) :name "iv-rel-hi")
(rule ((= l (lo x)) (= h (hi x)) (= l h)) ((union x (Num l))) :name "iv-point")
(rule ((= l (lo x))) ((IsInt x)) :name "int-lo")
(rule ((= h (hi x))) ((IsInt x)) :name "int-hi")

; The width of a relative range: for n >= 0 and b >= a, rel(b, n) - rel(a, n) <= b - a.
(rule ((= d (Sub (Rel b n) (Rel a n)))) ((Sub b a)) :name "rel-width-seed")
(rule ((= d (Sub (Rel b n) (Rel a n))) (= w (Sub b a)) (= (lo w) (hi w)) (= c (lo w)) (>= c 0))
      ((set (hi d) c)) :name "rel-width")

; --- order: every comparison also in one shape, 0 <= form, decided by the form's interval ---
(rule ((= x (Lt a b))) ((union x (Le (Num 0) (Sub (Sub b a) (Num 1))))) :name "lt-shape")
(rule ((= x (Le a b))) ((union x (Le (Num 0) (Sub b a)))) :name "le-shape")
(rule ((= x (Le (Num 0) y)) (= l (lo y)) (>= l 0)) ((union x (B true))) :name "le-true")
(rule ((= x (Le (Num 0) y)) (= h (hi y)) (< h 0)) ((union x (B false))) :name "le-false")
(rewrite (EqI a b) (And (Le a b) (Le b a)))
(rewrite (Not (Lt a b)) (Le b a))
(rewrite (Not (Le a b)) (Lt b a))
(rewrite (Le a b) (Not (Lt b a)))

; --- booleans and conditionals ---
(rewrite (Not (B b)) (B (not b)))
(rewrite (Not (Not a)) a)
(rewrite (And (B true) a) a)
(rewrite (And a (B true)) a)
(rewrite (And (B false) a) (B false))
(rewrite (And a (B false)) (B false))
(rewrite (And a a) a)
(rewrite (Or (B false) a) a)
(rewrite (Or a (B false)) a)
(rewrite (Or (B true) a) (B true))
(rewrite (Or a (B true)) (B true))
(rewrite (If (B true) a b) a)
(rewrite (If (B false) a b) b)
(rewrite (If c a a) a)
(rewrite (If c (B true) (B false)) c)
(rewrite (If c (B false) (B true)) (Not c))
(rewrite (If (Not c) a b) (If c b a))
(rewrite (If c (If c a b) d) (If c a d))
(rewrite (If c a (If c b d)) (If c a d))

; --- strict equality: undefined is a constant like any other ---
(rewrite (StrictEq a b) (StrictEq b a))
(rewrite (StrictEq (Num a) (Num b)) (B (bool-= a b)))
(rewrite (StrictEq (Num a) (Undef)) (B false))
(rewrite (StrictEq (B a) (Undef)) (B false))
(rewrite (StrictEq (Undef) (Undef)) (B true))
(rewrite (StrictEq (B a) (B b)) (B (not (xor a b))))
(rewrite (StrictEq (At xs k) (Undef)) (B false))
(rewrite (StrictEq (If c a b) d) (If c (StrictEq a d) (StrictEq b d)))
(rule ((= x (StrictEq a b)) (IsInt a) (IsInt b)) ((union x (EqI a b))) :name "eq-int")

; --- lists, by length and indexed read (every At rule carries its own bounds test) ---
(rewrite (IndexQ xs k) (If (And (Le (Num 0) k) (Lt k (Len xs))) (At xs k) (Undef)))
(rewrite (Len (Nil)) (Num 0))
(rewrite (Len (Cons h t)) (Add (Num 1) (Len t)))
(rewrite (Len (Append a b)) (Add (Len a) (Len b)))
(rewrite (Len (Sublist xs s e)) (Max (Sub e s) (Num 0)))
(rewrite (Len (Map f xs)) (Len xs))
(rewrite (Len (Reverse xs)) (Len xs))
(rewrite (Append (Nil) b) b)
(rewrite (Append a (Nil)) a)
(rewrite (Append (Cons h t) b) (Cons h (Append t b)))
(rewrite (Append (If c a b) t) (If c (Append a t) (Append b t)))
(rewrite (At (Nil) k) (Oob))
(rewrite (At (Cons h t) k) (If (Lt (Num 0) k) (At t (Sub k (Num 1))) (If (EqI k (Num 0)) h (Oob))))
(rewrite (At (Append a b) k) (If (Lt k (Num 0)) (Oob) (If (Lt k (Len a)) (At a k) (At b (Sub k (Len a))))))
(rewrite (At (Sublist xs s e) k) (If (And (Le (Num 0) k) (Lt k (Sub e s))) (At xs (Add s k)) (Oob)))
(rewrite (At (Map f xs) k) (If (And (Le (Num 0) k) (Lt k (Len xs))) (App f (At xs k)) (Oob)))
(rewrite (At (Reverse xs) k) (If (And (Le (Num 0) k) (Lt k (Len xs))) (At xs (Sub (Sub (Len xs) (Num 1)) k)) (Oob)))
(rewrite (At (If c a b) k) (If c (At a k) (At b k)))
(rewrite (IndexQ (If c a b) k) (If c (IndexQ a k) (IndexQ b k)))
(rewrite (Filteri f k (Nil)) (Nil))
(rewrite (Filteri f k (Cons h t)) (If (Truthy (App (App f h) k)) (Cons h (Filteri f (Add k (Num 1)) t)) (Filteri f (Add k (Num 1)) t)))
(rewrite (Filteri f k (If c a b)) (If c (Filteri f k a) (Filteri f k b)))
; A predicate that tests only "index === j" (j reads neither the element nor the index) keeps
; exactly the element at index j: Filteri started at index k over xs keeps xs[j - k] when
; k <= j < k + len xs, and nothing otherwise. It is applied only to an array the structural rules
; cannot open (a variable): on a list they can open, they already reach the same result, and a
; second conditional shape for that list sets the If-distribution rules multiplying against each
; other (70k e-nodes on the filter holdout).
(rule ((= x (Filteri (Lam e (Lam idx (StrictEq (Var idx) j))) k xs)) (= xs (Var name)) (!= e idx) (= fj (free j))
       (set-not-contains fj e) (set-not-contains fj idx))
      ((union x (If (And (Le k j) (Lt j (Add k (Len xs)))) (Cons (At xs (Sub j k)) (Nil)) (Nil)))) :name "filteri-index-eq")

; Every slice has a width, whoever consumes it.
(rule ((= s (Sublist xs a b))) ((Len s)) :name "width-seed")
; A list whose length is proven to lie in [0, 1] is empty or its own first element; a decided
; length gets its one shape, never a conditional with a dead branch.
(rule ((= l (Len xs)) (= (lo l) 0) (= (hi l) 1))
      ((union xs (If (Lt (Num 0) l) (Cons (At xs (Num 0)) (Nil)) (Nil)))) :name "short-list")
(rule ((= l (Len xs)) (= (hi l) 0)) ((union xs (Nil))) :name "short-nil")
(rule ((= l (Len xs)) (= (lo l) 1) (= (hi l) 1)) ((union xs (Cons (At xs (Num 0)) (Nil)))) :name "short-one")

; --- fold ---
(rewrite (Foldl f z (Nil)) z)
(rewrite (Foldl f z (Cons h t)) (Foldl f (App (App f z) h) t))
(rewrite (Foldl f z (If c a b)) (If c (Foldl f z a) (Foldl f z b)))
; F4, the one lemma (induction on the list): a step whose body does not read the accumulator
; returns its last element's image, or the seed when there is none.
(rule ((= x (Foldl (Lam acc (Lam v body)) z xs)) (!= acc v) (= fb (free body)) (set-not-contains fb acc))
      ((union x (If (Lt (Num 0) (Len xs)) (Let v (At xs (Sub (Len xs) (Num 1))) body) z))) :name "F4")

; --- maybe: (Maybe z m) is m, or z where m is undefined ---
(rewrite (Maybe z (Undef)) z)
(rewrite (Maybe (Undef) m) m)
(rewrite (Maybe z (Oob)) (Oob))
(rewrite (Maybe z (Maybe z m)) (Maybe z m))
(rewrite (Maybe z (At xs k)) (At xs k))
(rewrite (Maybe z (Num n)) (Num n))

; I1, seeding: a total read At(xs, k) has its partial twin IndexQ(xs, k).
(rule ((= x (At xs k))) ((IndexQ xs k)) :name "I1-seed")
; M1: a conditional that picks a read or a default, beside the read's own absence, is that
; absence eliminated with the default.
(rule ((= r (If c (At xs k) z)) (= m (If c (At xs k) (Undef)))) ((union r (Maybe z m))) :name "M1")

; --- consistency: a sound rule set never merges two distinct constructors ---
(rule ((= x (Nil)) (= x (Cons h t))) ((Clash x)) :name "clash-nil-cons")
(rule ((= x (Undef)) (= x (Num k))) ((Clash x)) :name "clash-undef-num")
(rule ((= x (Undef)) (= x (At xs k))) ((Clash x)) :name "clash-undef-at")
(rule ((= x (B true)) (= x (B false))) ((Clash x)) :name "clash-bool")
(rule ((= x (Num a)) (= x (Num b)) (!= a b)) ((Clash x)) :name "clash-num")
(rule ((= l (lo x)) (= h (hi x)) (> l h)) ((Clash x)) :name "clash-interval")
